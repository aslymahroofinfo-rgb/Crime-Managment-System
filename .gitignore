# Environment files (contain local secrets)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
client/.env
client/.env.*
!client/.env.example

# Dependencies
node_modules/
backend/node_modules/
client/node_modules/
frontend/node_modules/
reactjs/node_modules/

# Build output
dist/
client/dist/
reactjs/dist/

# Uploads and User Evidence (must never be committed to git)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
