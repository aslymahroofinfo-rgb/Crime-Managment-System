# Crime Investigation & Complaint Management System (CIW) - Backend Environment Configuration

# Server Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# Explicit Mock Mode Flag (set true for development mock fallback, false for MongoDB)
# Note: Mock data mode is rejected automatically if NODE_ENV=production
USE_MOCK_DATA=true

# MongoDB Connection String (Atlas URI or local mongod)
MONGO_URI=mongodb://localhost:27017/crime_complaint_db

# Cryptographically Secure JWT Secret Key (required - minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Frontend Client URL for CORS Whitelisting
CLIENT_URL=http://localhost:5174

# Optional: Email Service Credentials (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ciw-police.gov.lk

